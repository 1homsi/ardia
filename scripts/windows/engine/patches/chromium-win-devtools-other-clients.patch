--- a/content/browser/devtools/devtools_agent_host_impl.cc
+++ b/content/browser/devtools/devtools_agent_host_impl.cc
@@ -681,6 +681,22 @@
 
 protocol::TargetAutoAttacher* DevToolsAgentHostImpl::auto_attacher() {
   return nullptr;
+}
+
+bool ArdiaHasOtherDevToolsClient(
+    DevToolsAgentHost* host,
+    const std::vector<const DevToolsAgentHostClient*>& ours) {
+  for (DevToolsSession* session :
+       static_cast<DevToolsAgentHostImpl*>(host)->sessions()) {
+    bool own = false;
+    for (const DevToolsAgentHostClient* client : ours) {
+      own = own || client == session->GetClient();
+    }
+    if (!own) {
+      return true;
+    }
+  }
+  return false;
 }
 
 }  // namespace content
