#!/bin/bash
# Builds a release APK whose JavaScript is one commit, and stamps it with that commit and the native tree's state.
#
#   apps/phone/scripts/build-apk <name> [--commit REV] [--compose-key] [--store] [--direct] [--no-r8] [--abi ABI[,ABI]]
#
# The bundle comes from an export of REV (default HEAD at start, see bundle-export.ts), so edits and commits in the
# working tree during the build don't reach it; the export is deleted afterwards. Kotlin, resources and the native
# module still build from the working tree, and the stamp says at which commit and whether that tree was clean or
# written during the build. --direct bundles the working tree instead, behind the bundle guard. Writes
# $ARDIA_APK_DIR/<name>.apk (default /tmp/ardia-phone) and <name>.txt beside it. --compose-key re-signs it with the
# Compose app's key (~/.android/debug.keystore) for the upgrade test; --store builds without the lab switch.
# The release is shrunk with R8, and its reports (mapping, usage, seeds, configuration, missing rules) are kept
# in <name>-r8/ beside the APK. --no-r8 builds the unshrunk control. --abi builds only those ABIs (default
# arm64-v8a,x86_64, from gradle.properties), e.g. --abi arm64-v8a for what a phone gets from a split.
set -euo pipefail
if [ $# -lt 1 ] || [ "$1" = "--help" ] || [ "$1" = "-h" ]; then
  sed -n '2,14p' "$0" | sed 's/^# \{0,1\}//'
  [ $# -ge 1 ] && exit 0 || exit 64
fi
name="$1"
shift
composeKey=0
lab=1
direct=0
r8=1
rev=HEAD
while [ $# -gt 0 ]; do
  case "$1" in
    --compose-key) composeKey=1 ;;
    --store) lab=0 ;;
    --direct) direct=1 ;;
    --r8) r8=1 ;;
    --no-r8) r8=0 ;;
    --abi) abis="$2"; shift ;;
    --commit) rev="$2"; shift ;;
    *) echo "unknown option $1" >&2; exit 64 ;;
  esac
  shift
done
here="$(cd "$(dirname "$0")" && pwd)"
root="$(cd "$here/../../.." && pwd)"
out="${ARDIA_APK_DIR:-/tmp/ardia-phone}"
tools="$(ls -d "${ANDROID_HOME:-$HOME/Library/Android/sdk}"/build-tools/* | sort -V | tail -1)"
free=$(df -g /System/Volumes/Data | awk 'NR==2 {print $4}')
if [ "$free" -lt 10 ]; then
  echo "only ${free} GB free on the data volume: not building" >&2
  exit 1
fi
started=$(node -e 'console.log(Date.now())')
gradleArgs=()
exportDir=""
removeExport() {
  if [ -n "$exportDir" ]; then
    node --no-warnings "$here/bundle-export.ts" remove "$exportDir" || echo "could not remove the bundle export $exportDir" >&2
  fi
}
trap removeExport EXIT
if [ "$direct" = "1" ]; then
  [ "$rev" = "HEAD" ] || { echo "--direct bundles the working tree, so it takes no --commit" >&2; exit 64; }
  node --no-warnings "$here/bundle-guard.ts" check --root "$root"
  commit="$(git -C "$root" rev-parse HEAD)"
  source="working tree"
else
  made="$(node --no-warnings "$here/bundle-export.ts" create --commit "$rev" --root "$root")"
  exportDir="$(printf '%s' "$made" | node -e 'console.log(JSON.parse(require("fs").readFileSync(0, "utf8")).dir)')"
  commit="$(printf '%s' "$made" | node -e 'console.log(JSON.parse(require("fs").readFileSync(0, "utf8")).commit)')"
  gradleArgs=(-PardiaBundleExport="$exportDir")
  source="export of the commit"
fi
echo "bundling $commit from the $source"
[ "$r8" = "1" ] && gradleArgs+=(-Pandroid.enableMinifyInReleaseBuilds=true)
[ -n "${abis:-}" ] && gradleArgs+=(-PreactNativeArchitectures="$abis")
ARDIA_LAB=$lab "$here/gradle-locked" :app:assembleRelease ${gradleArgs[@]+"${gradleArgs[@]}"} --max-workers=4 --console=plain -q
nativeAfter="$(node --no-warnings "$here/bundle-guard.ts" native --since "$started" --root "$root")"
mkdir -p "$out"
built="$out/$name.building.apk"
cp "$root/apps/phone/android/app/build/outputs/apk/release/app-release.apk" "$built"
if [ "$composeKey" = "1" ]; then
  "$tools/apksigner" sign --v4-signing-enabled false --ks "$HOME/.android/debug.keystore" --ks-key-alias androiddebugkey --ks-pass pass:android --key-pass pass:android "$built"
fi
resources="$("$tools/aapt2" dump resources "$built")"
stamp() { printf '%s\n' "$resources" | grep -A1 "string/$1" | sed -n 's/.*"\(.*\)".*/\1/p' | head -1; }
stamped="$(stamp ardia_build_commit)"
dirty="$(stamp ardia_build_dirty)"
stampedSource="$(stamp ardia_build_source)"
nativeStamp="$(stamp ardia_build_native)"
if [ "$stamped" != "$commit" ] || [ "$dirty" != "no" ] || [ "$stampedSource" != "$source" ]; then
  mv "$built" "$out/$name.rejected.apk"
  echo "the APK says ${stamped:-no commit}, dirty: ${dirty:-unknown}, from the ${stampedSource:-unknown}, but this build bundled $commit from the $source: kept as $name.rejected.apk, not shipped" >&2
  exit 1
fi
apk="$out/$name.apk"
mv "$built" "$apk"
if [ "$r8" = "1" ]; then
  mkdir -p "$out/$name-r8"
  cp "$root/apps/phone/android/app/build/outputs/mapping/release/"*.txt "$out/$name-r8/" 2>/dev/null || true
fi
version="$("$tools/aapt2" dump badging "$apk" | sed -n "s/.*versionCode='\([0-9]*\)'.*/\1/p" | head -1)"
signer="$("$tools/apksigner" verify --print-certs "$apk" | sed -n 's/.*SHA-256 digest: //p' | head -1)"
sum="$(shasum -a 256 "$apk" | cut -d' ' -f1)"
{
  echo "apk: $name.apk"
  echo "commit: $commit"
  echo "dirty: $dirty"
  echo "bundle: from the $source"
  echo "native at configuration: $nativeStamp"
  echo "native after the build: $nativeAfter"
  echo "lab: $([ "$lab" = "1" ] && echo on || echo off)"
  echo "r8: $([ "$r8" = "1" ] && echo on || echo off)"
  echo "abis: ${abis:-arm64-v8a,x86_64 (gradle.properties)}"
  echo "versionCode: $version"
  echo "signer sha256: $signer"
  echo "sha256: $sum"
} > "$out/$name.txt"
cat "$out/$name.txt"
