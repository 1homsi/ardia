#!/bin/bash
# Builds a release APK of the committed tree and stamps it with its commit.
#
#   apps/phone/scripts/build-apk <name> [--compose-key] [--store]
#
# Writes $ARDIA_APK_DIR/<name>.apk (default /tmp/ardia-phone) and <name>.txt beside it with the commit, the
# dirty flag, the signer and sha256, the commit and flag read back from the APK itself. --compose-key re-signs it
# with the Compose app's key (~/.android/debug.keystore) for the upgrade test; --store builds without the lab
# switch. The bundle guard in Gradle refuses a tree with uncommitted changes Metro would read.
set -euo pipefail
if [ $# -lt 1 ] || [ "$1" = "--help" ] || [ "$1" = "-h" ]; then
  sed -n '2,9p' "$0" | sed 's/^# \{0,1\}//'
  [ $# -ge 1 ] && exit 0 || exit 64
fi
name="$1"
shift
composeKey=0
lab=1
for argument in "$@"; do
  case "$argument" in
    --compose-key) composeKey=1 ;;
    --store) lab=0 ;;
    *) echo "unknown option $argument" >&2; exit 64 ;;
  esac
done
here="$(cd "$(dirname "$0")" && pwd)"
root="$(cd "$here/../../.." && pwd)"
out="${ARDIA_APK_DIR:-/tmp/ardia-phone}"
tools="$(ls -d "${ANDROID_HOME:-$HOME/Library/Android/sdk}"/build-tools/* | sort -V | tail -1)"
free=$(df -g /System/Volumes/Data | awk 'NR==2 {print $4}')
if [ "$free" -lt 10 ]; then
  echo "only ${free} GB free on the data volume: not building" >&2
  exit 1
fi
node --no-warnings "$here/bundle-guard.ts" check --root "$root"
commit="$(git -C "$root" rev-parse HEAD)"
ARDIA_LAB=$lab "$here/gradle-locked" :app:assembleRelease --max-workers=4 --console=plain -q
mkdir -p "$out"
built="$out/$name.building.apk"
cp "$root/apps/phone/android/app/build/outputs/apk/release/app-release.apk" "$built"
if [ "$composeKey" = "1" ]; then
  "$tools/apksigner" sign --v4-signing-enabled false --ks "$HOME/.android/debug.keystore" --ks-key-alias androiddebugkey --ks-pass pass:android --key-pass pass:android "$built"
fi
resources="$("$tools/aapt2" dump resources "$built")"
stamped="$(printf '%s\n' "$resources" | grep -A1 'string/ardia_build_commit' | sed -n 's/.*"\(.*\)".*/\1/p' | head -1)"
dirty="$(printf '%s\n' "$resources" | grep -A1 'string/ardia_build_dirty' | sed -n 's/.*"\(.*\)".*/\1/p' | head -1)"
if [ "$stamped" != "$commit" ] || [ "$dirty" != "no" ]; then
  mv "$built" "$out/$name.rejected.apk"
  echo "the APK says commit ${stamped:-none}, dirty: ${dirty:-unknown}, but the build started at $commit: kept as $name.rejected.apk, not shipped" >&2
  exit 1
fi
apk="$out/$name.apk"
mv "$built" "$apk"
version="$("$tools/aapt2" dump badging "$apk" | sed -n "s/.*versionCode='\([0-9]*\)'.*/\1/p" | head -1)"
signer="$("$tools/apksigner" verify --print-certs "$apk" | sed -n 's/.*SHA-256 digest: //p' | head -1)"
sum="$(shasum -a 256 "$apk" | cut -d' ' -f1)"
{
  echo "apk: $name.apk"
  echo "commit: $commit"
  echo "dirty: $dirty"
  echo "lab: $([ "$lab" = "1" ] && echo on || echo off)"
  echo "versionCode: $version"
  echo "signer sha256: $signer"
  echo "sha256: $sum"
} > "$out/$name.txt"
cat "$out/$name.txt"
